{
  "permissions": {
    "deny": [
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform state*)",
      "Bash(terraform taint*)",
      "Bash(terraform untaint*)",
      "Bash(terraform force-unlock*)",
      "PowerShell(terraform apply*)",
      "PowerShell(terraform destroy*)",
      "PowerShell(terraform import*)",
      "PowerShell(terraform state*)",
      "PowerShell(terraform taint*)",
      "PowerShell(terraform untaint*)",
      "PowerShell(terraform force-unlock*)",
      "Read(environments/*/terraform.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.backup)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git add *)",
      "PowerShell(git stash *)"
    ]
  },
  "autoMemoryEnabled": false
}
