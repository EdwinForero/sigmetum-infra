# Copia este archivo a terraform.tfvars y rellena los valores.
# terraform.tfvars está en .gitignore — nunca lo versiones.
# Referencia completa de claves: docs/referencia-modulos.md

# Correo que recibe las notificaciones SNS de Beanstalk (health, deploy).
notification_email = "tu@email.com"

# Nombre del bucket S3 de datos. Debe ser único globalmente en AWS.
bucket_name = "sigmetum-app-assets-dev"

# URL del repositorio de GitHub del frontend que Amplify clonará.
github_repository = "https://github.com/TU_ORG/sigmetum-frontend"

# Token clásico de GitHub con scopes "repo" y "admin:repo_hook".
# Genera uno en: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Rótalo periódicamente (hallazgo S10). Usa el mismo valor en dev y prod.
github_access_token = "ghp_CHANGE_ME"

app_env_vars = {
  # Puerto interno del proceso Node.js. Beanstalk redirige el 80 aquí vía nginx.
  PORT = "8000"

  # Región AWS donde está el bucket. Debe coincidir con la del proveedor Terraform.
  AWS_REGION = "eu-west-3"

  # Nombre del bucket S3 — debe coincidir con bucket_name de arriba.
  AWS_BUCKET_NAME = "sigmetum-app-assets-dev"

  # Secretos (no van aquí): JWT_SECRET, ADMIN_PASSWORD y EMAIL_PASSWORD viven en Parameter Store
  # como SecureString, en /sigmetum/dev/backend/<CLAVE>. Se crean a mano; Terraform no lee ni escribe
  # su valor. Procedimiento: docs/integracion/para-backend.md (sección «Secretos en Parameter Store: procedimiento humano»). La validation de app_env_vars rechaza las tres claves.

  # Duración del token JWT (ej. "10m", "1h", "7d").
  JWT_EXPIRATION = "10m"

  # Usuario del administrador inicial del sistema.
  ADMIN_USERNAME = "CHANGE_ME_admin_user"

  # Origen exacto del frontend, sin barra final. Usado para CORS.
  # Primera vuelta de apply: deja vacío (""). Amplify genera la URL tras el apply;
  # cópiala aquí y repite el apply.
  # Formato: https://featuretesting.<id>.amplifyapp.com
  ALLOWED_ORIGIN = ""

  # Cuenta de correo desde la que el backend envía emails.
  EMAIL = "tu@email.com"

  # Saltos de proxy delante de Express (cadena entera de 1 a 5, sin espacios ni ceros a la izquierda).
  # Opcional en el backend (1 si no se define; en dev 1 es incorrecto). En dev se midió lo que recibe nginx; para Express es deducido: CloudFront, nginx, Express = 2.
  # Procedimiento y tabla: docs/integracion/para-backend.md (sección 6).
  TRUST_PROXY_HOPS = "2"
}
