# Copia este archivo a terraform.tfvars y rellena los valores.
# terraform.tfvars está en .gitignore — nunca lo versiones.
# Referencia completa de claves: docs/referencia-modulos.md

# Correo que recibe las notificaciones SNS de Beanstalk (health, deploy).
notification_email = "tu@email.com"

# Nombre del bucket S3 de datos. Debe ser único globalmente en AWS.
bucket_name = "sigmetum-app-assets-prod"

# URL del repositorio de GitHub del frontend que Amplify clonará.
github_repository = "https://github.com/EdwinForero/sigmetum-frontend"

# Token clásico de GitHub con scopes "repo" y "admin:repo_hook".
# Genera uno en: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Rótalo periódicamente (hallazgo S10). Usa el mismo valor en dev y prod.
github_access_token = "ghp_CHANGE_ME"

# ARN del certificado ACM para el listener HTTPS del ALB.
# Solicítalo en: AWS Console → Certificate Manager → eu-west-1 → Request certificate
# Dominio: *.sigmetum-a.org (o backend.sigmetum-a.org). El ARN aparece tras la validación DNS.
ssl_certificate_arn = "arn:aws:acm:eu-west-3:ACCOUNT_ID:certificate/CERT_ID"

app_env_vars = {
  # Puerto interno del proceso Node.js. Beanstalk redirige el 80 aquí vía nginx.
  PORT = "8000"

  # Región AWS donde está el bucket. Debe coincidir con la del proveedor Terraform.
  AWS_REGION = "eu-west-3"

  # Nombre del bucket S3 — debe coincidir con bucket_name de arriba.
  AWS_BUCKET_NAME = "sigmetum-app-assets-prod"

  # Secreto del backend: EMAIL_PASSWORD. Viaja como propiedad de entorno de Beanstalk y puede verse en la
  # salida de terraform plan y en el estado: no pegues esa salida.
  # EMAIL_PASSWORD: contraseña de aplicación de la cuenta EMAIL.
  EMAIL_PASSWORD = "CHANGE_ME_email_app_credential"

  # COGNITO_USER_POOL_ID no va aquí: la inyecta Terraform desde el módulo cognito.

  # Las claves extra que ya tengas en tu terraform.tfvars siguen siendo válidas; ver docs/referencia-modulos.md
  # AVISO: el backend desplegado en prod aún depende de claves de la transición que ya no están en esta
  # plantilla: no copies esta plantilla sobre un terraform.tfvars en uso.

  # Formato: dos orígenes https separados por coma, sin barra final ni espacios obligatorios:
  # https://<dominio>,https://www.<dominio>
  # El backend compara cada origen de forma exacta.
  ALLOWED_ORIGIN = "https://CHANGE_ME_frontend_origin"

  # Cuenta de correo desde la que el backend envía emails.
  EMAIL = "tu@email.com"

  # Saltos de proxy delante de Express (cadena entera de 1 a 5, sin espacios ni ceros a la izquierda).
  # Opcional en el backend (1 si no se define). Mismo valor que dev, POR CONFIRMAR: recorrido esperado ALB, nginx, Express; prod no está medido.
  # Procedimiento de medición: docs/integracion/para-backend.md (sección 6).
  TRUST_PROXY_HOPS = "2"
}
