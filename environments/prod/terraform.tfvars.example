# Copia este archivo a terraform.tfvars y rellena los valores.
# terraform.tfvars está en .gitignore — nunca lo versiones.
# Referencia completa de claves: docs/referencia-modulos.md

# Correo que recibe las notificaciones SNS de Beanstalk (health, deploy).
notification_email = "tu@email.com"

# Nombre del bucket S3 de datos. Debe ser único globalmente en AWS.
bucket_name = "sigmetum-app-prod"

# URL del repositorio de GitHub del frontend que Amplify clonará.
github_repository = "https://github.com/EdwinForero/sigmetum-frontend"

# Token clásico de GitHub con scope "repo".
# Genera uno en: GitHub → Settings → Developer settings → Personal access tokens → Tokens (classic)
# Rótalo periódicamente (hallazgo S10). Usa el mismo valor en dev y prod.
github_access_token = "ghp_CHANGE_ME"

# ARN del certificado ACM para el listener HTTPS del ALB.
# Solicítalo en: AWS Console → Certificate Manager → eu-west-1 → Request certificate
# Dominio: *.sigmetum-a.org (o backend.sigmetum-a.org). El ARN aparece tras la validación DNS.
ssl_certificate_arn = "arn:aws:acm:eu-west-1:ACCOUNT_ID:certificate/CERT_ID"

app_env_vars = {
  # Puerto interno del proceso Node.js. Beanstalk redirige el 80 aquí vía nginx.
  PORT = "8000"

  # Región AWS donde está el bucket. Debe coincidir con la del proveedor Terraform.
  AWS_REGION = "eu-west-1"

  # Nombre del bucket S3 — debe coincidir con bucket_name de arriba.
  AWS_BUCKET_NAME = "sigmetum-app-prod"

  # Clave secreta para firmar los JWT. Genera con: openssl rand -hex 32
  # Usa un valor DISTINTO al de dev.
  JWT_SECRET = "CHANGE_ME_openssl_rand_hex_32"

  # Duración del token JWT (ej. "10m", "1h", "7d").
  JWT_EXPIRATION = "10m"

  # Usuario del administrador inicial del sistema.
  ADMIN_USERNAME = "CHANGE_ME_admin_user"

  # Hash bcrypt del password del admin. NUNCA el texto en claro.
  # Genera con: node -e "require('bcryptjs').hash('tupassword',10).then(console.log)"
  # (npm install -g bcryptjs si no lo tienes)
  ADMIN_PASSWORD = "CHANGE_ME_bcrypt_hash"

  # Origen exacto del frontend de prod, sin barra final. Usado para CORS.
  # Será el dominio propio cuando esté configurado (hallazgo C9),
  # o la URL de Amplify: https://master.<id>.amplifyapp.com
  ALLOWED_ORIGIN = "https://CHANGE_ME_frontend_origin"

  # Cuenta de correo desde la que el backend envía emails.
  EMAIL = "tu@email.com"

  # Contraseña de aplicación de Gmail (no la de tu cuenta).
  # Genera en: Google → Cuenta → Seguridad → Verificación en dos pasos → Contraseñas de aplicación
  EMAIL_PASSWORD = "CHANGE_ME_app_password"
}
